QWidget { background: transparent; color: @text-primary; font-family: 'Segoe UI'; font-size: 13px; }
QMainWindow, QStackedWidget { background: @background; }
QFrame#sidebar { background: @sidebar; border-right: 1px solid @border; }
QFrame#topbar { background: @background; border-bottom: 1px solid @border; }
QFrame[card="true"] { background: @surface; border: 1px solid @border; border-radius: 20px; }
QLabel { border: none; background: transparent; }
QLabel[role="muted"] { color: @muted; }
QLabel[role="eyebrow"] { color: @text-secondary; font-size: 11px; font-weight: 700; }
QLabel[role="title"] { font-size: 26px; font-weight: 700; }
QLabel[role="heading"] { font-size: 17px; font-weight: 600; }
QLabel[role="metric"] { font-size: 30px; font-weight: 700; }
QPushButton { background: @surface-raised; border: 1px solid @border; border-radius: 10px; padding: 10px 16px; font-weight: 600; }
QPushButton:hover { background: @hover; }
QPushButton:focus, QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus, QPlainTextEdit:focus { border: 2px solid @focus; }
QPushButton:disabled { color: @muted; background: @surface; }
QPushButton[primary="true"] { background: @primary; border-color: @primary; color: @on-primary; }
QPushButton[primary="true"]:hover { background: @secondary; }
QPushButton[nav="true"] { text-align: left; border: none; background: transparent; padding: 13px 16px; border-radius: 12px; }
QPushButton[nav="true"]:hover { background: @hover; }
QPushButton[nav="true"]:checked { background: @primary; color: @on-primary; }
QPushButton[danger="true"] { color: @danger; border-color: @danger; }
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QPlainTextEdit, QListWidget { background: @surface-raised; border: 1px solid @border; border-radius: 9px; padding: 9px 12px; selection-background-color: @primary; selection-color: @on-primary; }
QComboBox::drop-down { border: none; width: 26px; }
QComboBox QAbstractItemView { background: @surface-raised; color: @text-primary; selection-background-color: @primary; selection-color: @on-primary; }
QCheckBox { spacing: 10px; padding: 5px 0; }
QCheckBox::indicator { width: 17px; height: 17px; border: 1px solid @border; background: @surface-raised; border-radius: 5px; }
QCheckBox::indicator:checked { background: @primary; border: 2px solid @focus; }
QCheckBox::indicator:focus { border: 2px solid @focus; }
QScrollArea { border: none; background: transparent; }
QScrollBar:vertical { width: 8px; background: transparent; margin: 0; }
QScrollBar::handle:vertical { background: @border; min-height: 25px; border-radius: 4px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
QProgressBar { border: 1px solid @border; border-radius: 7px; background: @surface-raised; text-align: center; height: 15px; }
QProgressBar::chunk { background: @primary; border-radius: 6px; }
QTableWidget { background: @surface; border: 1px solid @border; border-radius: 14px; gridline-color: @border; selection-background-color: @hover; selection-color: @text-primary; }
QHeaderView::section { background: @surface-raised; border: none; border-bottom: 1px solid @border; padding: 12px; font-weight: 600; }
QTableWidget::item { padding: 10px; border: none; }
QToolTip { background: @surface-raised; color: @text-primary; border: 1px solid @border; padding: 8px; }
QDialog, QMessageBox { background: @surface; }
QDialogButtonBox QPushButton { min-width: 85px; }
