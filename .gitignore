# Publish only the application, tests and reviewed project documentation.
# New root-level files remain local until intentionally allowed here.
/*
!/.gitattributes
!/.gitignore
!/.gitleaks.toml
!/.kekkai.example.yml
!/LICENSE
!/README.md
!/README.pt-BR.md
!/requirements.txt
!/kekkai.py
!/kekkai/
!/tests/

/kekkai/*
!/kekkai/*.py
!/kekkai/ai/
!/kekkai/core/
!/kekkai/gui/
!/kekkai/assets/
!/kekkai/dashboard/
!/kekkai/locales/
!/kekkai/prompts/
!/kekkai/themes/
/kekkai/ai/*
!/kekkai/ai/*.py
/kekkai/core/*
!/kekkai/core/*.py
/kekkai/gui/*
!/kekkai/gui/*.py
/kekkai/assets/*
!/kekkai/assets/logo.png
!/kekkai/assets/logo+nome.png
/kekkai/dashboard/*
!/kekkai/dashboard/*.py
!/kekkai/dashboard/styles.css
!/kekkai/dashboard/template.html
/kekkai/locales/*
!/kekkai/locales/en.json
/kekkai/prompts/*
!/kekkai/prompts/security.md
/kekkai/themes/*
!/kekkai/themes/__init__.py
!/kekkai/themes/desktop.qss
!/kekkai/themes/tokens.json
/tests/*
!/tests/test_*.py

# Defense in depth for sensitive/runtime files anywhere in allowed folders.
.kekkai.yml
.security/
.kekkai/
.env
.env.*
*.pem
*.key
*.p12
*.pfx
credentials*.json
secrets*.json
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.log
*.tmp
*.zip
